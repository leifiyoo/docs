{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "luma",
  "name": "LockiPrefixes Docs",
  "colors": {
    "primary": "#5865F2",
    "light": "#7C86FF",
    "dark": "#3F4CCF"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "global": {
      "anchors": [
        {
          "anchor": "GitHub",
          "icon": "github",
          "href": "https://github.com/leifiyoo/lockiprefixes"
        },
        {
          "anchor": "LuckPerms",
          "icon": "user-shield",
          "href": "https://luckperms.net"
        }
      ]
    },
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Getting started",
            "pages": [
              "index",
              "quickstart",
              "versions"
            ]
          },
          {
            "group": "Server setup",
            "pages": [
              "configuration",
              "commands",
              "placeholders"
            ]
          },
          {
            "group": "Development",
            "pages": [
              "development"
            ]
          }
        ]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "GitHub",
        "href": "https://github.com/locki/lockiprefixes"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Open Quickstart",
      "href": "/quickstart"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/locki/lockiprefixes"
    }
  }
}
